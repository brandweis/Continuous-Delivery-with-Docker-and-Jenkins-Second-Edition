pipeline {

  agent {
    label 'week11'
  }

  triggers {
    pollSCM('* * * * *')  // or webhook if set up
  }

  environment {
    IMAGE_NAME = "brandweis/calculator:${BUILD_TIMESTAMP}"
    LOCAL_IMAGE = "localhost:5000/brandweis/calculator:${BUILD_TIMESTAMP}"
  }

  stages {

    stage("Checkout") {
      steps {
        git url: 'https://github.com/brandweis/Continuous-Delivery-with-Docker-and-Jenkins-Second-Edition.git',
            branch: 'staging-environment'
      }
    }

    stage("Compile") {
      steps {
        sh 'cd Chapter08/sample1 && ./gradlew compileJava'
      }
    }

    stage("Unit test") {
      steps {
        sh 'cd Chapter08/sample1 && ./gradlew test'
      }
    }

    stage("Code coverage") {
      steps {
        sh 'cd Chapter08/sample1 && ./gradlew jacocoTestReport'
        sh 'cd Chapter08/sample1 && ./gradlew jacocoTestCoverageVerification'
      }
    }

    stage("Static code analysis") {
      steps {
        sh 'cd Chapter08/sample1 && ./gradlew checkstyleMain'
      }
    }

    stage("Build") {
      steps {
        sh 'cd Chapter08/sample1 && ./gradlew build'
      }
    }

    stage("Docker build") {
      steps {
        sh 'docker build -t $IMAGE_NAME Chapter08/sample1'
        sh 'docker tag $IMAGE_NAME $LOCAL_IMAGE'
      }
    }

    stage("Docker push") {
      steps {
        sh 'docker push $LOCAL_IMAGE'
      }
    }

    stage("Update version") {
      steps {
        sh 'cd Chapter08/sample1 && sed -i "s/{{VERSION}}/${BUILD_TIMESTAMP}/g" deployment.yaml'
      }
    }

    stage("Deploy to staging") {
      steps {
        sh '''
          kubectl config use-context docker-desktop
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/hazelcast.yaml
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/deployment.yaml
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/service.yaml
        '''
      }
    }

    stage("Acceptance test") {
      steps {
        sleep time: 60, unit: 'SECONDS'
        sh 'cd Chapter08/sample1 && chmod +x acceptance-test.sh && ./acceptance-test.sh'
      }
    }

    stage("Release") {
      steps {
        sh '''
          kubectl config use-context gke_ex11-456820_us-east1_hello-cluster
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/hazelcast.yaml
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/deployment.yaml
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/service.yaml
        '''
      }
    }

    stage("Smoke test") {
      steps {
        sleep time: 60, unit: 'SECONDS'
        sh 'cd Chapter08/sample1 && chmod +x smoke-test.sh && ./smoke-test.sh'
      }
    }

  }

}

