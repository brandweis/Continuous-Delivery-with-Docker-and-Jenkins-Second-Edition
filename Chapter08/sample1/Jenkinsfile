pipeline {
  agent {
    label 'week11'
  }

  triggers {
    pollSCM('* * * * *')
  }

  environment {
    BUILD_TIMESTAMP = "${new Date().format('yyyyMMddHHmmss')}"
    IMAGE_NAME = "brandweis/calculator:${BUILD_TIMESTAMP}"
    LOCAL_IMAGE = "localhost:5000/brandweis/calculator:${BUILD_TIMESTAMP}"
  }

  stages {

    stage("Checkout") {
      steps {
        git url: 'https://github.com/brandweis/Continuous-Delivery-with-Docker-and-Jenkins-Second-Edition.git',
            branch: 'staging-environment'
      }
    }

    stage("Docker build & push") {
      steps {
        sh '''
          docker build -t $IMAGE_NAME Chapter08/sample1
          docker tag $IMAGE_NAME $LOCAL_IMAGE
          docker push $LOCAL_IMAGE
          docker push $IMAGE_NAME
        '''
      }
    }

    stage("Update version") {
      steps {
        sh 'cd Chapter08/sample1 && sed -i "s|{{VERSION}}|${BUILD_TIMESTAMP}|g" calculator.yaml'
      }
    }

    stage("Deploy to staging (local)") {
      steps {
        sh '''
          kubectl config use-context docker-desktop
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/hazelcast.yaml
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/calculator.yaml
        '''
      }
    }

    stage("Deploy to release (GKE)") {
      steps {
        sh '''
          kubectl config use-context gke_ex11-456820_us-east1_hello-cluster
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/hazelcast.yaml
          kubectl --insecure-skip-tls-verify apply -f Chapter08/sample1/calculator.yaml
        '''
      }
    }
  }
}

