pipeline {
    agent any

    environment {
        IMAGE = 'localhost:5001/calculator:exercise9'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build Image') {
            steps {
                dir('Chapter08/sample1') {
                    sh 'docker build -t $IMAGE .'
                    sh 'docker push $IMAGE'
                }
            }
        }

        stage('Test Calculator /div Endpoint') {
            steps {
                script {
                    sh 'docker network create jenkins-test || true'
                    sh 'docker run -d --rm --name hazelcast --network jenkins-test hazelcast/hazelcast:3.12'
                    sh 'docker run -d --rm --name calculator --network jenkins-test -p 5002:8080 $IMAGE'
                    sleep(time: 10, unit: 'SECONDS') // Give the app time to start
                    sh 'docker run --rm --network jenkins-test curlimages/curl curl -f "http://calculator:8080/div?a=10&b=2"'
                }
            }
        }
    }

    post {
        always {
            sh 'docker stop hazelcast || true'
            sh 'docker stop calculator || true'
            sh 'docker network rm jenkins-test || true'
        }
    }
}

