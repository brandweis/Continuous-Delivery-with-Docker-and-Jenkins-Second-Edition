pipeline {
  agent any

  environment {
    IMAGE_NAME = 'localhost:5001/calculator:1.0'
    NETWORK = 'jenkins'
  }

  stages {
    stage('Deploy Calculator and Hazelcast') {
      steps {
        sh '''
          echo "Cleaning up any old containers..."
          docker stop hazelcast || true
          docker stop calculator || true
          docker rm -f hazelcast || true
          docker rm -f calculator || true
          docker network create ${NETWORK} || true

          echo "Starting Hazelcast..."
          docker run -d --rm --name hazelcast --network ${NETWORK} hazelcast/hazelcast:5.0.2

          echo "Waiting for Hazelcast to become ready..."
          until docker exec hazelcast curl -s localhost:5701/hazelcast/health | grep -q "HEALTHY"; do
            echo "Waiting for Hazelcast..."
            sleep 2
          done

          echo "Starting calculator container..."
          docker run -d --rm --name calculator --network ${NETWORK} ${IMAGE_NAME}

          echo "Giving calculator app time to start..."
          sleep 5
        '''
      }
    }

    stage('Test Division') {
      steps {
        sh '''
          echo "Testing valid division..."
          DIV_RESULT=$(curl -s calculator:8080/div?a=6\\&b=2)
          echo "Result: $DIV_RESULT"
          if [ "$DIV_RESULT" -eq 3 ]; then
            echo "Division test passed"
          else
            echo "Division test failed"
            exit 1
          fi

          echo "Testing divide-by-zero..."
          ERROR_RESULT=$(curl -s -o /dev/null -w "%{http_code}" calculator:8080/div?a=6\\&b=0)
          if [ "$ERROR_RESULT" -ne 200 ]; then
            echo "Divide-by-zero error returned properly"
          else
            echo "Divide-by-zero test failed"
            exit 1
          fi
        '''
      }
    }
  }

  post {
    always {
      sh '''
        echo "Cleaning up containers and network..."
        docker stop calculator || true
        docker stop hazelcast || true
        docker network rm ${NETWORK} || true
      '''
      echo "Pipeline completed. Check logs for test output."
    }
  }
}

