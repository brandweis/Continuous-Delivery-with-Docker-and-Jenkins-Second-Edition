pipeline {
  agent any

  environment {
    REGISTRY = 'localhost:5001'
    IMAGE = "${REGISTRY}/calculator:1.0"
    NETWORK = 'jenkins'
  }

  stages {
    stage('Deploy Calculator and Hazelcast') {
      steps {
        sh '''
          docker network create ${NETWORK} || true
          docker run -d --rm --name hazelcast --network ${NETWORK} hazelcast/hazelcast:5.0.2
          docker run -d --rm --name calculator --network ${NETWORK} -p 8080:8080 ${IMAGE}
          sleep 10
        '''
      }
    }

    stage('Test Division') {
      steps {
        sh '''
          DIV_RESULT=$(curl -s calculator:8080/div?a=6\\&b=2)
          test "$DIV_RESULT" -eq 3

          ERROR_MSG=$(curl -s calculator:8080/div?a=6\\&b=0 || true)
          echo "$ERROR_MSG" | grep -qi "error"
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker stop calculator || true
        docker stop hazelcast || true
        docker network rm ${NETWORK} || true
      '''
    }
  }
}

