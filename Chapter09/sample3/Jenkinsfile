pipeline {
  agent any

  environment {
    REGISTRY = 'localhost:5001'
    IMAGE = "${REGISTRY}/calculator:1.0"
    NETWORK = 'jenkins'
  }

  stages {
    stage('Deploy Calculator and Hazelcast') {
      steps {
        script {
          sh '''
            echo Creating Docker network if not exists...
            docker network create ${NETWORK} || true

            echo Starting Hazelcast...
            docker run -d --rm --name hazelcast --network ${NETWORK} hazelcast/hazelcast:5.0.2

            echo Waiting for Hazelcast to be ready...
            i=1
            while [ $i -le 10 ]; do
              if docker run --rm --network ${NETWORK} curlimages/curl curl -sf http://hazelcast:5701/hazelcast/health; then
                echo Hazelcast is healthy.
                break
              else
                echo Retry $i: Hazelcast not ready yet.
                i=$((i+1))
                sleep 5
              fi
            done

            echo Starting Calculator...
            docker run -d --rm --name calculator --network ${NETWORK} -p 8081:8080 ${IMAGE}

            echo Waiting for Calculator to start...
            sleep 10
          '''
        }
      }
    }

    stage('Test Division') {
      steps {
        script {
          sh '''
            echo Testing division: 6 / 2
            DIV_RESULT=$(curl -s http://localhost:8081/div?a=6\\&b=2)
            echo "Result: $DIV_RESULT"
            if [ "$DIV_RESULT" = "3" ]; then
              echo "PASS: Division result is correct."
            else
              echo "FAIL: Division result incorrect or empty."
              exit 1
            fi

            echo Testing divide by zero: 6 / 0
            ZERO_RESULT=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8081/div?a=6\\&b=0)
            echo "HTTP status: $ZERO_RESULT"
            if [ "$ZERO_RESULT" -ge 400 ]; then
              echo "PASS: Divide-by-zero returned error as expected."
            else
              echo "FAIL: Expected error on divide by zero."
              exit 1
            fi
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        sh '''
          echo Cleaning up...
          docker stop calculator || true
          docker stop hazelcast || true
          docker network rm ${NETWORK} || true
        '''
      }
      echo 'Pipeline completed. Check logs for test output.'
    }
  }
}

