pipeline {
  agent any

  environment {
    HOST_PORT = "8081"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Deploy Calculator and Hazelcast') {
      steps {
        script {
          sh '''
            echo Creating Docker network if not exists...
            docker network create jenkins || true

            echo Starting Hazelcast...
            docker run -d --rm --name hazelcast --network jenkins hazelcast/hazelcast:5.0.2

            echo Waiting for Hazelcast to be ready...
            i=1
            while [ "$i" -le 10 ]; do
              docker run --rm --network jenkins curlimages/curl curl -sf http://hazelcast:5701/hazelcast/health && break
              echo Retry $i: Hazelcast not ready yet.
              i=`expr $i + 1`
              sleep 5
            done

            echo Starting Calculator on port $HOST_PORT...
            docker run -d --rm --name calculator \\
              --network jenkins \\
              -p $HOST_PORT:8080 \\
              -v /var/jenkins_home/workspace/ex9-pipeline/Chapter09/sample3/hazelcast-client.yaml:/app/hazelcast-client.yaml \\
              -e SPRING_HAZELCAST_CONFIG=file:/app/hazelcast-client.yaml \\
              localhost:5001/calculator:1.0

            echo Waiting for Calculator to start...
            sleep 10
          '''
        }
      }
    }

    stage('Test Division') {
      steps {
        script {
          sh '''
            echo Testing division: 6 / 2
            RESULT=$(curl -s "http://localhost:$HOST_PORT/div?a=6&b=2")
            echo "Division Result: $RESULT"
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        sh '''
          echo Cleaning up...
          docker stop calculator || true
          docker stop hazelcast || true
          docker network rm jenkins || true
        '''
      }
      echo 'Pipeline completed. Check logs for test output.'
    }
  }
}

