pipeline {
  agent any

  environment {
    REGISTRY   = 'localhost:5001'
    IMAGE_NAME = 'calculator'
    IMAGE_TAG  = '1.0'
    HOST_PORT  = '8081'
  }

  stages {
    stage('Deploy Calculator and Hazelcast') {
      steps {
        script {
          sh '''
            echo Creating Docker network if not exists...
            docker network create jenkins || true

            echo Starting Hazelcast...
            docker run -d --rm --name hazelcast --network jenkins hazelcast/hazelcast:5.0.2

            echo Waiting for Hazelcast to be ready...
            i=1
            until docker run --rm --network jenkins curlimages/curl curl -sf http://hazelcast:5701/hazelcast/health || [ $i -eq 10 ]; do
              echo Retry $i: Hazelcast not ready yet.
              i=$((i+1))
              sleep 5
            done

            echo Starting Calculator on port ${HOST_PORT}...
            docker run -d --name calculator --network jenkins -p ${HOST_PORT}:8080 ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}

            echo Waiting for Calculator to start...
            sleep 10
          '''
        }
      }
    }

    stage('Test Division') {
      steps {
        script {
          sh '''
            echo Testing division: 6 / 2
            RESULT=$(curl -s http://localhost:${HOST_PORT}/div?a=6\\&b=2)
            echo "Result: $RESULT"
            if [ "$RESULT" = "3" ]; then
              echo "Division test passed"
            else
              echo "Division test failed"
              exit 1
            fi

            echo Testing divide-by-zero
            RESPONSE=$(curl -s -w "%{http_code}" -o /dev/null http://localhost:${HOST_PORT}/div?a=6\\&b=0)
            if [ "$RESPONSE" = "400" ] || [ "$RESPONSE" = "500" ]; then
              echo "Divide-by-zero test passed (received HTTP $RESPONSE)"
            else
              echo "Divide-by-zero test failed (received HTTP $RESPONSE)"
              exit 1
            fi
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        sh '''
          echo Cleaning up...
          docker stop calculator || true
          docker stop hazelcast || true
          docker network rm jenkins || true
        '''
      }
      echo 'Pipeline completed. Check logs for test output.'
    }
  }
}

